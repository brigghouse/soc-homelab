<!--
  local_rules.xml - custom detections for the soc-homelab project.

  Install on WAZUH01:
    sudo cp local_rules.xml /var/ossec/etc/rules/local_rules.xml
    sudo chown wazuh:wazuh /var/ossec/etc/rules/local_rules.xml
    sudo /var/ossec/bin/wazuh-analysisd -t        # syntax check, must print no errors
    sudo systemctl restart wazuh-manager

  Notes
    * Custom rule IDs must be in the 100000-120000 range.
    * Field names follow Wazuh's Windows eventchannel decoder (win.system.*, win.eventdata.*).
    * Paths are matched without backslashes on purpose: the decoder escapes "\" so
      "\\" handling differs between versions; matching on file names avoids that trap.
    * Parent groups (windows, sysmon, sysmon_event1) come from the default Wazuh ruleset.
      If a rule never fires, check the parent with the event in the Discover view and
      adjust the if_group (see docs/03-detections.md).
-->
<group name="soc_homelab,">

  <!-- =========================================================== -->
  <!-- T1110 Brute Force: failed logons                             -->
  <!-- =========================================================== -->
  <rule id="100100" level="3">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4625$|^4771$</field>
    <description>Lab: failed logon for $(win.eventdata.targetUserName) (event $(win.system.eventID))</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100101" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Lab: 8+ failed logons in 2 minutes for $(win.eventdata.targetUserName) - possible password guessing</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- T1136 Create Account                                        -->
  <!-- =========================================================== -->
  <rule id="100110" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4720$</field>
    <description>Lab: user account $(win.eventdata.targetUserName) created by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1136</id>
    </mitre>
    <group>account_changed,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- T1098 Account Manipulation: member added to privileged group -->
  <!-- 4728 global, 4732 local/domain-local, 4756 universal group   -->
  <!-- =========================================================== -->
  <rule id="100111" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4728$|^4732$|^4756$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)^(Domain Admins|Enterprise Admins|Schema Admins|Administrators|Account Operators|Backup Operators|Server Operators)$</field>
    <description>Lab: member added to privileged group $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>account_changed,privilege_escalation,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- T1059.001 PowerShell with an encoded command (Sysmon 1)      -->
  <!-- Matches -e, -ec, -enc, -encodedcommand and /e variants       -->
  <!-- =========================================================== -->
  <rule id="100120" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s[-/]e(c|n[a-z]*)?\s</field>
    <description>Lab: PowerShell started with an encoded command by $(win.eventdata.user)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
  </rule>

  <!-- =========================================================== -->
  <!-- T1053.005 Scheduled Task created with schtasks (Sysmon 1)    -->
  <!-- =========================================================== -->
  <rule id="100121" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s/create\s</field>
    <description>Lab: scheduled task created from the command line by $(win.eventdata.user)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- =========================================================== -->
  <!-- T1069.002 / T1087.002 Domain group and account discovery     -->
  <!-- =========================================================== -->
  <rule id="100122" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)net1?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\sgroup\s.*(domain admins|enterprise admins))|(\s(user|group)\s.*/domain)</field>
    <description>Lab: domain group/account discovery by $(win.eventdata.user): $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1069.002</id>
      <id>T1087.002</id>
    </mitre>
  </rule>

  <!-- =========================================================== -->
  <!-- T1547.001 Registry Run key persistence (Sysmon 13)           -->
  <!-- =========================================================== -->
  <rule id="100130" level="10">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^13$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)CurrentVersion.(Run|RunOnce).</field>
    <description>Lab: autostart Run key set by $(win.eventdata.image)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

</group>
